<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <VersionPrefix>3.0.0</VersionPrefix>
    <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Mailozaurr.Gmail</AssemblyName>
    <PackageId>Mailozaurr.Gmail</PackageId>
    <Description>Gmail API email transport and mailbox operations for .NET.</Description>
    <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageIcon>Mailozaurr.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EvotecIT/Mailozaurr</PackageProjectUrl>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/Mailozaurr</RepositoryUrl>
    <PackageTags>Mail;Email;Gmail;Google</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailozaurr.Internet\Mailozaurr.Internet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GmailJsonContext.cs" />
    <Compile Include="GmailOAuthHelpers.cs" />
    <Compile Include="GmailNativeMailboxOperations.cs" />
    <Compile Include="GmailMailboxBrowserSession.cs" />
    <Compile Include="GmailMailboxSearcher.cs" />
    <Compile Include="..\Mailozaurr.Internet\Gmail\**\*.cs" Link="Gmail\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Mailozaurr.Internet\DmarcReports\GmailDmarcReportService.cs" Link="DmarcReports\GmailDmarcReportService.cs" />
    <Compile Include="..\Mailozaurr.Internet\NonDeliveryReports\GmailNonDeliveryReportService.cs" Link="NonDeliveryReports\GmailNonDeliveryReportService.cs" />
    <Compile Include="..\Mailozaurr.Internet\SentMessages\Senders\GmailPendingMessageSender.cs" Link="SentMessages\GmailPendingMessageSender.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MimeKit" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" Condition=" '$(TargetFramework)' != 'net8.0' " />
    <None Include="..\..\Mailozaurr.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.MD" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mailozaurr.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mailozaurr.PowerShell</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
