<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <VersionPrefix>3.0.0</VersionPrefix>
    <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Mailozaurr</PackageId>
    <Description>All Mailozaurr email transports, provider integrations, and email-artifact interoperability for .NET.</Description>
    <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Dependency-only meta-packages intentionally have framework dependency groups without lib/ref assets. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageIcon>Mailozaurr.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EvotecIT/Mailozaurr</PackageProjectUrl>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/Mailozaurr</RepositoryUrl>
    <PackageTags>Windows;MacOS;Linux;Mail;Email;SMTP;IMAP;POP3;Graph;Gmail;PST;OST;OLM;Mbox;EMLX;Maildir</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailozaurr\Mailozaurr.Internet.csproj" />
    <ProjectReference Include="..\Mailozaurr.MicrosoftGraph\Mailozaurr.MicrosoftGraph.csproj" />
    <ProjectReference Include="..\Mailozaurr.Gmail\Mailozaurr.Gmail.csproj" />
    <ProjectReference Include="..\Mailozaurr.Artifacts\Mailozaurr.Artifacts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Mailozaurr.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.MD" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
