<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Company>Evotec</Company>
        <Authors>Przemyslaw Klys</Authors>
        <VersionPrefix>2.0.0</VersionPrefix>
        <PackageId>Mailozaurr.Cli</PackageId>
        <Description>Command-line and MCP host for Mailozaurr profiles, mailbox operations, drafts, queues, and delivery.</Description>
        <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Keep PublishAot scoped to the CLI instead of propagating it to multi-targeted project references. -->
        <PublishAot Condition=" '$(MailozaurrPublishAot)' == 'true' ">true</PublishAot>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mailozaurr</ToolCommandName>
        <PackageIcon>Mailozaurr.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/EvotecIT/Mailozaurr</PackageProjectUrl>
        <PackageReadmeFile>README.MD</PackageReadmeFile>
        <RepositoryUrl>https://github.com/EvotecIT/Mailozaurr</RepositoryUrl>
        <PackageTags>Windows;MacOS;Linux;Mail;Email;Graph;Gmail;IMAP;SMTP;CLI;MCP</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mailozaurr.Application\Mailozaurr.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
      <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
      <PackageReference Include="System.CommandLine" Version="2.0.9" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\Mailozaurr.png" Pack="true" PackagePath="\" />
        <None Include="..\..\README.MD" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
