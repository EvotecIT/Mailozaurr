<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <VersionPrefix>3.0.0</VersionPrefix>
    <OfficeIMOVersion>3.2.2</OfficeIMOVersion>
    <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Mailozaurr.Artifacts</AssemblyName>
    <PackageId>Mailozaurr.Artifacts</PackageId>
    <Description>OfficeIMO.Email and MimeKit interoperability for EML, MSG, OFT, TNEF, and protected-message artifacts.</Description>
    <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageIcon>Mailozaurr.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EvotecIT/Mailozaurr</PackageProjectUrl>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/Mailozaurr</RepositoryUrl>
    <PackageTags>Mail;Email;EML;MSG;OFT;TNEF;MIME;OfficeIMO</PackageTags>
    <OfficeIMORoot Condition=" '$(OfficeIMORoot)' == '' ">..\..\..\OfficeIMO</OfficeIMORoot>
    <UseOfficeIMOProjectReferences Condition=" '$(UseOfficeIMOProjectReferences)' == '' ">false</UseOfficeIMOProjectReferences>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Mailozaurr\MailFiles\**\*.cs" Link="MailFiles\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MimeKit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(UseOfficeIMOProjectReferences)' == 'true' ">
    <ProjectReference Include="$(OfficeIMORoot)\OfficeIMO.Email\OfficeIMO.Email.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(UseOfficeIMOProjectReferences)' != 'true' ">
    <PackageReference Include="OfficeIMO.Email" Version="$(OfficeIMOVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Mailozaurr.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.MD" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mailozaurr.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mailozaurr.PowerShell</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
