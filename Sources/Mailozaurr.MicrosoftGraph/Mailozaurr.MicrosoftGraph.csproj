<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <VersionPrefix>3.0.0</VersionPrefix>
    <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Mailozaurr.MicrosoftGraph</AssemblyName>
    <PackageId>Mailozaurr.MicrosoftGraph</PackageId>
    <Description>Microsoft Graph email transport and mailbox operations for .NET.</Description>
    <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageIcon>Mailozaurr.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EvotecIT/Mailozaurr</PackageProjectUrl>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/Mailozaurr</RepositoryUrl>
    <PackageTags>Mail;Email;MicrosoftGraph;GraphApi</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailozaurr.Internet\Mailozaurr.Internet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GraphJsonContext.cs" />
    <Compile Include="GraphNativeMailboxOperations.cs" />
    <Compile Include="GraphEmailMessageContentExtensions.cs" />
    <Compile Include="GraphMailboxSearcher.cs" />
    <Compile Include="..\Mailozaurr.Internet\Enums\GraphEndpoint.cs;..\Mailozaurr.Internet\Enums\GraphImportance.cs;..\Mailozaurr.Internet\Enums\GraphMailboxRole.cs" Link="Enums\%(Filename)%(Extension)" />
    <Compile Include="..\Mailozaurr.Internet\Authentication\OAuthHelpers.cs;..\Mailozaurr.Internet\Authentication\TokenCacheHelper.cs" Link="Authentication\%(Filename)%(Extension)" />
    <Compile Include="..\Mailozaurr.Internet\MicrosoftGraph\**\*.cs" Link="MicrosoftGraph\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Mailozaurr.Internet\EmailGraphMessage.cs;..\Mailozaurr.Internet\GraphCredential.cs;..\Mailozaurr.Internet\GraphEmailMessage.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\Mailozaurr.Internet\MailozaurrOptions.cs" Link="MailozaurrOptions.cs" />
    <Compile Include="..\Mailozaurr.Internet\NativeMailboxBrowserSessions.cs" Link="GraphMailboxBrowserSession.cs" />
    <Compile Include="..\Mailozaurr.Internet\MicrosoftGraphUtils*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\Mailozaurr.Internet\Receive\GraphMessageListener.cs" Link="Receive\GraphMessageListener.cs" />
    <Compile Include="..\Mailozaurr.Internet\DmarcReports\GraphDmarcReportService.cs" Link="DmarcReports\GraphDmarcReportService.cs" />
    <Compile Include="..\Mailozaurr.Internet\NonDeliveryReports\GraphNonDeliveryReportService.cs" Link="NonDeliveryReports\GraphNonDeliveryReportService.cs" />
    <Compile Include="..\Mailozaurr.Internet\SentMessages\Senders\GraphPendingMessageSender.cs" Link="SentMessages\GraphPendingMessageSender.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MimeKit" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" Condition=" '$(TargetFramework)' != 'net8.0' " />
    <None Include="..\..\Mailozaurr.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.MD" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mailozaurr.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mailozaurr.PowerShell</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
